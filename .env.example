# Local PostgreSQL
POSTGRES_DB=studyhub
POSTGRES_USER=studyhub
POSTGRES_PASSWORD=studyhub_dev
STUDYHUB_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5433/${POSTGRES_DB}

# Local RabbitMQ
RABBITMQ_DEFAULT_USER=studyhub
RABBITMQ_DEFAULT_PASS=rabbitmq_dev
STUDYHUB_AMQP_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@127.0.0.1:5672/%2F

# Enable Alice and Bob for local testing
STUDYHUB_DEV_IDENTITY=1

# Generate a different value for each token in your local .env
STUDYHUB_PROCESSING_TOKEN=
STUDYHUB_SEARCH_TOKEN=
STUDYHUB_SYNTHESIS_TOKEN=